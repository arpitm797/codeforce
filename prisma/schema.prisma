generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Problem {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  difficulty  String
  createdAt   DateTime     @default(now())

  testCases   TestCase[]
  submissions Submission[]
}

model TestCase {
  id        Int     @id @default(autoincrement())
  input     String
  output    String
  problemId Int

  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Submission {
  id        Int      @id @default(autoincrement())
  code      String
  language  String
  status    String
  problemId Int
  createdAt DateTime @default(now())

  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}